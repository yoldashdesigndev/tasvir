<UserControl x:Class="Tasvir.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="820">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}"/>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource Text.Section}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              DisplayMemberPath="Display" Style="{StaticResource Combo}" Width="240"
                              Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding QualityLabel}" Style="{StaticResource Text.Section}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}"
                                      Style="{StaticResource Combo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="{Binding BitrateLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding SelectedBitrate}"
                                      Style="{StaticResource Combo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding FrameRateLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate}"
                                      Style="{StaticResource Combo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Margin="0,10,12,0">
                            <TextBlock Text="{Binding RotationLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding RotationOptions}" SelectedItem="{Binding SelectedRotation}"
                                      Style="{StaticResource Combo}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ConnectionLabel}" Style="{StaticResource Text.Section}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <ToggleButton Content="USB" Style="{StaticResource Chip.Toggle}"
                                      IsChecked="{Binding PreferUsb, Mode=TwoWay}"/>
                        <ToggleButton Content="Wi-Fi" Style="{StaticResource Chip.Toggle}" Margin="8,0,0,0"
                                      IsChecked="{Binding PreferWifi, Mode=TwoWay}"/>
                    </StackPanel>
                    <CheckBox Content="{Binding AutoReconnectLabel}" Style="{StaticResource Check}"
                              IsChecked="{Binding AutoReconnect, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

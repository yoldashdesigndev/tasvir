<UserControl x:Class="Tasvir.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="760">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.PageTitle}"/>

            <Border Style="{StaticResource Card}" Padding="28" Margin="0,24,0,0">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left"
                            Background="{StaticResource Brush.Accent}">
                        <TextBlock Text="T" FontSize="26" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding AppName}" FontSize="28" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" Margin="0,20,0,0"/>
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Body}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,20,0,0"/>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,24,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding VersionLabel}"
                                   Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionValue}"
                                   Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding LicensesLabel}"
                                   Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicensesText}"
                                   Style="{StaticResource Text.Caption}" TextAlignment="Right" Margin="24,10,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Copyright}" Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Center" Margin="0,24,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Window x:Class="Tasvir.App.Views.WirelessConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="470" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI">
    <StackPanel Margin="28">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding OtherModeLabel}" Style="{StaticResource Button.Ghost}"
                    Command="{Binding ToggleModeCommand}"/>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Section}" FontSize="18"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="{Binding Instructions}" Style="{StaticResource Text.Body}" Margin="0,12,0,0"/>

        <TextBlock Text="{Binding HostLabel}" Style="{StaticResource Text.Label}"/>
        <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

        <StackPanel Visibility="{Binding IsConnectModeVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding PortLabel}" Style="{StaticResource Text.Label}"/>
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </StackPanel>

        <StackPanel Visibility="{Binding IsPairModeVisible, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding PortLabel}" Style="{StaticResource Text.Label}"/>
            <TextBox Text="{Binding PairPort, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
            <TextBlock Text="{Binding PairCodeLabel}" Style="{StaticResource Text.Label}"/>
            <TextBox Text="{Binding PairCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Input}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
        </StackPanel>

        <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource Brush.Success}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Error}"
                   FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="{Binding CancelLabel}" Style="{StaticResource Button.Ghost}"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                    Command="{Binding ConnectCommand}" Width="120" Height="38" Margin="8,0,0,0"
                    Visibility="{Binding IsConnectModeVisible, Converter={StaticResource BoolToVisibility}}"/>
            <Button Content="{Binding ActionLabel}" Style="{StaticResource Button.Primary}"
                    Command="{Binding PairCommand}" Width="120" Height="38" Margin="8,0,0,0"
                    Visibility="{Binding IsPairModeVisible, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="Tasvir.App.Views.MirrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Tasvir.App.Controls">
    <Grid Margin="32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="{Binding MirrorTitle}" Style="{StaticResource Text.PageTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border CornerRadius="14" Padding="12,6" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{StaticResource Brush.Warning}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Button Content="{Binding RefreshLabel}" Style="{StaticResource Button.Ghost}"
                        Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="318"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeviceName}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding DeviceSubtitle}" Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton Content="{Binding UsbLabel}" Style="{StaticResource Chip.Toggle}"
                                              IsChecked="{Binding IsUsbSelected, Mode=TwoWay}"/>
                                <ToggleButton Content="{Binding WifiLabel}" Style="{StaticResource Chip.Toggle}"
                                              IsChecked="{Binding IsWifiSelected, Mode=TwoWay}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Devices}"
                                      SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" Style="{StaticResource Combo}"
                                      ToolTip="{Binding DeviceSerialText}"/>
                            <Button Grid.Column="1" Content="{Binding ConnectWirelessLabel}"
                                    Style="{StaticResource Button.Ghost}" Command="{Binding ConnectWirelessCommand}"
                                    Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="{Binding DisconnectLabel}"
                                    Style="{StaticResource Button.Ghost}" Command="{Binding DisconnectCommand}"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PreviewCard}" Margin="0,16,0,16" ClipToBounds="True">
                    <Grid>
                        <controls:PhonePreviewHost x:Name="PreviewHost"
                                                   Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Width="232" Height="468" CornerRadius="30" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Background="{StaticResource Brush.Background}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="2"
                                Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Border Width="78" Height="7" CornerRadius="4" Background="{StaticResource Brush.SurfaceHover}"
                                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26,0">
                                    <Border Width="40" Height="40" CornerRadius="12" HorizontalAlignment="Center"
                                            Background="{StaticResource Brush.AccentSoft}">
                                        <TextBlock Text="T" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding PreviewPlaceholder}" Style="{StaticResource Text.Caption}"
                                               TextAlignment="Center" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding StartText}" Style="{StaticResource Button.Primary}"
                            Command="{Binding StartMirroringCommand}"
                            IsEnabled="{Binding CanStartMirroring}"/>
                    <Button Grid.Column="1" Content="{Binding StopText}" Style="{StaticResource Button.Ghost}"
                            Command="{Binding StopMirroringCommand}" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="{Binding FullscreenLabel}" Style="{StaticResource Button.Ghost}"
                            Command="{Binding ToggleFullscreenCommand}" Margin="4,0,0,0"/>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="{Binding QuickSettingsText}" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding ResolutionLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding SelectedResolution}"
                                      Style="{StaticResource Combo}"/>
                            <TextBlock Text="{Binding BitrateLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding SelectedBitrate}"
                                      Style="{StaticResource Combo}"/>
                            <TextBlock Text="{Binding FrameRateLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding FrameRateOptions}" SelectedItem="{Binding SelectedFrameRate}"
                                      Style="{StaticResource Combo}"/>
                            <TextBlock Text="{Binding RotationLabel}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding RotationOptions}" SelectedItem="{Binding SelectedRotation}"
                                      Style="{StaticResource Combo}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DiagnosticsText}" Style="{StaticResource Text.Section}"/>
                            <TextBlock Text="{Binding MirroringStatusText}" Style="{StaticResource Text.Body}"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding DeviceCountLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding DevicesCountText}" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="{Binding MonitoringLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding MonitoringText}" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="{Binding AdbVersionLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding AdbVersionText}" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="{Binding DeviceSerialLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding DeviceSerialText}" Style="{StaticResource Text.Body}"/>
                            <TextBlock Text="{Binding LastErrorLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Error}"/>
                            <TextBlock Text="{Binding SettingsErrorLabel}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Text="{Binding SettingsErrorText}" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Brush.Warning}"/>
                            <TextBlock Text="{Binding EngineStatusText}" Style="{StaticResource Text.Caption}"
                                       Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

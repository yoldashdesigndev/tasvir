<Window x:Class="Tasvir.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasvir"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,30,24,0">
                    <Border Width="46" Height="46" CornerRadius="13"
                            Background="{StaticResource Brush.Accent}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="T" FontSize="24" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" Style="{StaticResource Text.Brand}" Margin="0,18,0,0"/>
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource Text.Tagline}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="14,42,14,0">
                    <TextBlock Text="MENU" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}" Margin="14,0,0,8"/>
                    <Button Content="{Binding NavMirror}" Style="{StaticResource Nav.Mirror}"
                            Command="{Binding NavigateMirrorCommand}"/>
                    <Button Content="{Binding NavSettings}" Style="{StaticResource Nav.Settings}"
                            Command="{Binding NavigateSettingsCommand}"/>
                    <Button Content="{Binding NavAbout}" Style="{StaticResource Nav.About}"
                            Command="{Binding NavigateAboutCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,18"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Warning}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                    <Button Content="{Binding LanguageSwitchText}" Style="{StaticResource Button.Ghost}"
                            Command="{Binding ToggleLanguageCommand}"
                            HorizontalAlignment="Left" Margin="-6,16,0,0"/>
                </StackPanel>

                <Grid/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>

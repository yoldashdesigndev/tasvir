<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.Background">#0B1020</Color>
    <Color x:Key="Color.Surface">#121A2E</Color>
    <Color x:Key="Color.SurfaceAlt">#18223B</Color>
    <Color x:Key="Color.SurfaceHover">#1E2A48</Color>
    <Color x:Key="Color.Border">#24304D</Color>
    <Color x:Key="Color.Accent">#7C5CFC</Color>
    <Color x:Key="Color.AccentHover">#9278FF</Color>
    <Color x:Key="Color.AccentSoft">#2A2350</Color>
    <Color x:Key="Color.TextPrimary">#E8ECF7</Color>
    <Color x:Key="Color.TextSecondary">#9AA7C7</Color>
    <Color x:Key="Color.TextMuted">#66739A</Color>
    <Color x:Key="Color.Success">#3FD08A</Color>
    <Color x:Key="Color.Warning">#F5B544</Color>
    <Color x:Key="Color.Error">#FF6B7A</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/>
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent"/>
</ResourceDictionary>

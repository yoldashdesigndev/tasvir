<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1822</NoWarn>
    <AssemblyName>Tasvir.ViewModels</AssemblyName>
    <RootNamespace>Tasvir.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tasvir.Core\Tasvir.Core.csproj" />
    <ProjectReference Include="..\Tasvir.Services\Tasvir.Services.csproj" />
  </ItemGroup>

</Project>

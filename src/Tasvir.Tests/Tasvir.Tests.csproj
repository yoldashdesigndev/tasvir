<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <AssemblyName>Tasvir.Tests</AssemblyName>
    <RootNamespace>Tasvir.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tasvir.Core\Tasvir.Core.csproj" />
    <ProjectReference Include="..\Tasvir.Services\Tasvir.Services.csproj" />
    <ProjectReference Include="..\Tasvir.ViewModels\Tasvir.ViewModels.csproj" />
  </ItemGroup>

</Project>
